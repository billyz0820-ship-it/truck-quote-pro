# 环境配置示例文件
# 复制此文件为 .env 并修改相应配置
# 注意：Vite 环境变量需要 VITE_ 前缀

# 自定义构建模式 (development|staging|production)
VITE_BUILD_MODE=development

# 开发环境API配置
# VITE_BUILD_MODE=development
# API地址: http://localhost:3001/api

# 测试环境API配置  
# VITE_BUILD_MODE=staging
# API地址: https://staging-api.truckquote.com/api

# 生产环境API配置
# VITE_BUILD_MODE=production
# API地址: https://api.truckquote.com/api

# 其他环境变量示例
# VITE_API_BASE_URL=http://localhost:3001/api
# VITE_APP_TITLE=北美卡车经纪系统